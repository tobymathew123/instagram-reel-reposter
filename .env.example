# =====================================================================
#  Instagram Reel Auto-Reposter - SETTINGS
#
#  1. Copy this file and name the copy ".env"  (the setup script does it for you)
#  2. Fill in the values below. README.md tells you exactly where each one comes from.
#  3. After ANY change, run the setup script again so the change is applied.
#
#  Rules: no spaces around "=", no quotes needed. Never share this file.
# =====================================================================


# ---------------------------------------------------------------------
# A. PUBLIC ADDRESS (README step 4)
#    Instagram needs a public https address to reach your computer.
# ---------------------------------------------------------------------

# Which tunnel to use: "ngrok" (recommended, free) or "cloudflare"
COMPOSE_PROFILES=ngrok

# Your public domain WITHOUT https:// and without a trailing slash.
#   ngrok example:      PUBLIC_DOMAIN=calm-tiger-example.ngrok-free.app
#   cloudflare example: PUBLIC_DOMAIN=reels.yourdomain.com
PUBLIC_DOMAIN=

# Only if COMPOSE_PROFILES=ngrok -> https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# Only if COMPOSE_PROFILES=cloudflare -> Cloudflare Zero Trust > Networks > Tunnels > your tunnel > token
CLOUDFLARE_TUNNEL_TOKEN=


# ---------------------------------------------------------------------
# B. META / INSTAGRAM (README step 8)
# ---------------------------------------------------------------------

# A password YOU invent; you paste the same value into the Meta webhook settings.
# Leave empty and the setup script will create a random one for you.
META_VERIFY_TOKEN=

# Never-expiring Page Access Token (printed by the "meta-token" helper script)
META_PAGE_ACCESS_TOKEN=

# Instagram Business Account ID of Account B, the channel that posts (printed by the helper; ~17 digits)
IG_BUSINESS_ACCOUNT_ID=

# Instagram-scoped ID of Account A, your personal account that SENDS the Reels.
# Leave empty at first; README step 9 shows how to find it.
ALLOWED_SENDER_IG_ID=

# Meta Graph API version. Only change this if Meta tells you v22.0 is retired.
GRAPH_API_VERSION=v22.0


# ---------------------------------------------------------------------
# C. CANVA FRAME (README step 5)
# ---------------------------------------------------------------------

# EASIEST: leave this EMPTY and save your Canva PNG as  branding/frame.png  in this folder.
# Or paste a public link to the PNG (e.g. from Cloudinary): https://res.cloudinary.com/.../frame.png
CANVA_FRAME_PNG_URL=


# ---------------------------------------------------------------------
# D. AI CAPTIONS (README step 6)
# ---------------------------------------------------------------------

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# AI model. gemini-2.5-flash is free-tier friendly and fast.
GEMINI_MODEL=gemini-2.5-flash

# Describe your channel in one sentence. The AI uses this to write captions & pick hashtags.
CHANNEL_NICHE=Motivational fitness and healthy lifestyle tips for busy young professionals

# Optional line added to the end of every caption (leave empty for none)
CAPTION_FOOTER=Follow for more daily inspiration!

# Hashtags used if the AI is ever unavailable
FALLBACK_HASHTAGS=#reels #viral #explore #trending #fyp


# ---------------------------------------------------------------------
# E. BEHAVIOUR
# ---------------------------------------------------------------------

# Send you a DM back ("Posted!" / "Failed") after each Reel
SEND_DM_CONFIRMATIONS=true

# true  = TEST MODE: brands the video and writes the caption but does NOT post to Instagram
# false = LIVE: posts to Account B
DRY_RUN=true

# Your time zone (used for logs). Examples: America/New_York, Europe/London, Asia/Kolkata
TIMEZONE=UTC


# ---------------------------------------------------------------------
# F. INTERNAL (the setup script fills these in - you can ignore them)
# ---------------------------------------------------------------------

# Password between n8n and the video service. Auto-generated if empty.
FFMPEG_API_KEY=

# n8n version. "latest" is fine. Pin a number (e.g. 1.123.0) if an update ever breaks something.
N8N_VERSION=latest
